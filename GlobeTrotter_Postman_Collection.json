      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (Screen 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex_explorer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"city\": \"San Francisco\",\n  \"country\": \"USA\",\n  \"bio\": \"Travel enthusiast exploring world capitals.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login User (Screen 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
