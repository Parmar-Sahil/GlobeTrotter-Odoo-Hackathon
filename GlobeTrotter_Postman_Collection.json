        },
        {
          "name": "Search Destinations (Screen 3, 8)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/destinations/search?search=Paris&region=Europe&sortBy=popularityScore&sortOrder=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "destinations",
                "search"
              ],
              "query": [
